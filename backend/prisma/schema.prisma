datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Campaign {
  id          String   @id @default(uuid())
  title       String
  description String
  target      Float
  raised      Float    @default(0)
  status      String   @default("ACTIVE") // "ACTIVE", "PAUSED", "COMPLETED"
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations   Donation[]
}

model Donation {
  id               String   @id @default(uuid())

  // Provider
  provider         String   @default("NOWPAYMENTS") // "NOWPAYMENTS" | "STRIPE"
  frequency        String   @default("ONE_TIME")    // "ONE_TIME" | "MONTHLY"

  // Donor info
  donorName        String
  donorEmail       String?

  // Payment identifiers
  nowPaymentsId          String?  @unique  // NOWPayments payment_id
  invoiceId              String?           // NOWPayments invoice_id
  stripeSessionId        String?  @unique  // Stripe checkout session ID
  stripePaymentIntentId  String?           // Stripe payment intent ID
  paypalOrderId          String?  @unique  // PayPal Order ID

  // Payment amounts
  usdAmount        Float             // amount in USD (gross requested)
  originalAmount   Float?            // amount user actually paid (in their currency)
  originalCurrency String?           // currency user paid in (btc, eth, usd, eur, gbp, etc.)

  // Payment metadata
  paymentMethod    String?           // e.g. "card", "apple_pay", "google_pay", "link", "usdt", "btc", "eth"
  paymentStatus    String   @default("WAITING")
  // WAITING | CONFIRMING | CONFIRMED | SENDING | FINISHED | PARTIALLY_PAID | FAILED | EXPIRED | REFUNDED

  // Settlement Fund Management (M0 / M1)
  settlementType          String    @default("M0") // "M0" (Instant) | "M1" (Next Business Day)
  settlementStatus        String    @default("PENDING") // "PENDING" | "PROCESSING" | "SETTLED" | "FAILED"
  feeAmount               Float     @default(0) // Gateway / processing fee in USD
  netSettlementAmount     Float     @default(0) // Net funds available (usdAmount - feeAmount)
  settledAt               DateTime? // Timestamp when settled
  estimatedSettlementDate DateTime? // Scheduled settlement date for M1

  // Optional campaign link
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  settlementLogs   SettlementLog[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SettlementLog {
  id             String   @id @default(uuid())
  donationId     String
  donation       Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  fromStatus     String
  toStatus       String
  settlementType String   // "M0" | "M1"
  amount         Float    // Gross USD
  fee            Float    // Fee USD
  netAmount      Float    // Net USD
  notes          String?
  createdAt      DateTime @default(now())
}
