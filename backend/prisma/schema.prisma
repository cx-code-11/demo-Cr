datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Campaign {
  id          String   @id @default(uuid())
  title       String
  description String
  target      Float
  raised      Float    @default(0)
  status      String   @default("ACTIVE") // "ACTIVE", "PAUSED", "COMPLETED"
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations   Donation[]
}

model Donation {
  id               String   @id @default(uuid())

  // Donor info
  donorName        String
  donorEmail       String?

  // NOWPayments identifiers
  nowPaymentsId    String?  @unique  // payment_id — used for idempotency
  invoiceId        String?           // NOWPayments invoice_id

  // Payment amounts
  usdAmount        Float             // amount in USD (requested)
  originalAmount   Float?            // amount user actually paid (in their currency)
  originalCurrency String?           // currency user paid in (btc, eth, usd, etc.)

  // Payment metadata
  paymentMethod    String?           // e.g. "btc", "eth", "usdtbsc", "card"
  paymentStatus    String   @default("WAITING")
  // WAITING | CONFIRMING | CONFIRMED | SENDING | FINISHED | PARTIALLY_PAID | FAILED | EXPIRED | REFUNDED

  // Optional campaign link
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
